{
  "name": "baoflashbrowser-next",
  "productName": "BaoFlashBrowser Next",
  "version": "0.0.1",
  "private": true,
  "main": "out/main/index.js",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "electron-vite dev --host 127.0.0.1",
    "start": "electron-vite preview",
    "typecheck": "vue-tsc --noEmit",
    "build": "node scripts/build.cjs",
    "smoke": "node scripts/test.cjs smoke",
    "smoke:bg": "node scripts/test.cjs smoke",
    "smoke:foreground": "node scripts/test.cjs smoke --foreground",
    "test:unit": "node scripts/test.cjs unit",
    "test:data": "node scripts/test.cjs data",
    "check": "npm run typecheck && node scripts/test.cjs unit && node scripts/test.cjs data && node scripts/test.cjs smoke",
    "smoke:packaged": "node scripts/test.cjs packaged",
    "pack:win": "node scripts/pack-win.cjs",
    "pack:win:public": "node scripts/pack-win.cjs --public",
    "smoke:packaged:public": "node scripts/test.cjs packaged",
    "runtime:prepare": "node scripts/prepare-runtime.cjs",
    "runtime:check": "node scripts/runtime-check.cjs",
    "runtime:export": "node scripts/runtime-export.cjs",
    "runtime:export:byop": "node scripts/runtime-export.cjs --byop",
    "runtime:import": "node scripts/runtime-import.cjs"
  },
  "dependencies": {
    "@fluentui/tokens": "1.0.0-alpha.24",
    "pinia": "3.0.4",
    "vue": "3.5.46"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "6.0.11",
    "electron": "39.8.10",
    "electron-builder": "26.18.1",
    "electron-vite": "5.0.0",
    "playwright": "1.65.1",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "^5.1.1",
    "vue-tsc": "3.3.14"
  }
}
