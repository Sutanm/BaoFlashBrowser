{
  "name": "bao-flash-browser",
  "version": "1.0.1",
  "description": "Cross-platform Flash browser based on Electron",
  "main": "dist/main.js",
  "scripts": {
    "build:main": "node esbuild.main.config.mjs",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "build": "npm run build:main && npm run build:renderer",
    "dev:main": "node esbuild.main.config.mjs --watch",
    "dev:renderer": "vite --config vite.renderer.config.ts",
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\"",
    "start": "npm run build && electron .",
    "icon": "node build/make-icon.js",
    "build:win": "npm run build && cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --win",
    "build:win64": "npm run build && cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --win --x64",
    "build:win32": "npm run build && cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --win --ia32",
    "build:linux": "npm run build && cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --linux",
    "build:all": "npm run build && electron-builder --win --linux",
    "lint": "eslint src/ --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ruffle-rs/ruffle": "^0.4.1",
    "dayjs": "^1.11.13",
    "dexie-react-hooks": "^4.4.0",
    "electron-log": "^4.4.8",
    "electron-store": "^6.0.1",
    "nanoid": "^3.3.7",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "dexie": "^4.4.4",
    "electron": "11.5.0",
    "electron-builder": "^24.13.0",
    "esbuild": "^0.28.1",
    "esbuild-plugin-copy": "^2.1.1",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "lucide-react": "^0.460.0",
    "playwright": "^1.42.0",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.4.0",
    "prettier": "^3.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.1",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "webpack": "^5.109.0",
    "zustand": "^5.0.0"
  },
  "author": "Sutanm",
  "license": "MIT",
  "build": {
    "appId": "com.bao.flashbrowser",
    "productName": "BaoFlashBrowser",
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "plugins",
        "to": "plugins"
      },
      {
        "from": "native",
        "to": "native"
      }
    ],
    "files": [
      "dist/**/*",
      "build/icon.ico"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Network"
    },
    "appImage": {
      "artifactName": "${productName}-${version}-x64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}
