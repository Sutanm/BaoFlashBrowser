{
  "name": "bao-flash-browser",
  "version": "1.0.1",
  "description": "Cross-platform Flash browser based on Electron",
  "main": "dist/main.js",
  "scripts": {
    "build:main": "webpack --config webpack.main.config.js",
    "build:renderer": "webpack --config webpack.renderer.config.js",
    "build": "npm run build:main && npm run build:renderer",
    "dev:main": "webpack --config webpack.main.config.js --watch",
    "dev:renderer": "webpack --config webpack.renderer.config.js --watch",
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\"",
    "start": "npm run build && electron .",
    "icon": "node build/make-icon.js",
    "build:win": "npm run build && cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --win",
    "build:win64": "npm run build && cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --win --x64",
    "build:win32": "npm run build && cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --win --ia32",
    "build:linux": "npm run build && electron-builder --linux",
    "build:all": "npm run build && electron-builder --win --linux",
    "lint": "eslint src/ --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "test": "jest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "electron-log": "^4.4.8",
    "electron-store": "^7.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-react": "^7.23.3",
    "@babel/preset-typescript": "^7.23.3",
    "@mozilla/readability": "^0.5.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^12.1.5",
    "@types/react": "^17.0.75",
    "@types/react-dom": "^17.0.25",
    "@types/sortablejs": "^1.15.8",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "autoprefixer": "^10.5.4",
    "babel-loader": "^9.1.3",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.4",
    "dexie": "^4.4.4",
    "electron": "11.5.0",
    "electron-builder": "^22.14.13",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "fuse.js": "^6.6.2",
    "jest": "^29.7.0",
    "jotai": "^1.13.1",
    "lucide-react": "^1.27.0",
    "mini-css-extract-plugin": "^2.10.2",
    "playwright": "^1.42.0",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.5.23",
    "postcss-loader": "^8.2.1",
    "prettier": "^3.2.0",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "sharp": "^0.35.1",
    "sortablejs": "^1.15.6",
    "style-loader": "^4.0.0",
    "tailwindcss": "^3.4.19",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.5.1",
    "typescript": "^4.9.5",
    "validator": "^13.15.35",
    "webpack": "^5.109.0",
    "webpack-cli": "^5.1.4"
  },
  "author": "Sutanm",
  "license": "MIT",
  "build": {
    "appId": "com.bao.flashbrowser",
    "productName": "BaoFlashBrowser",
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "plugins",
        "to": "plugins"
      }
    ],
    "files": [
      "dist/**/*",
      "build/icon.ico"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}
