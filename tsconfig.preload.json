{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "nodenext",
    "target": "ES2019",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "moduleResolution": "nodenext",
    "types": ["node"],
    "outDir": "dist/preload"
  },
  "include": [
    "src/preload/**/*",
    "src/webview-preload/**/*",
    "src/shared/**/*"
  ]
}
