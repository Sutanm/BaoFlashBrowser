  void WebViewImpl::SetVisibilityState(
@@ -145,17 +160,16 @@ index 40f302d34f6683b150f1cfb910990bd31e4d9122..aaca59ceb75089353a23ed045a32cfe7
      bool is_initial_state) {
    DCHECK(GetPage());
 +
-+  if (!scheduler_throttling_allowed_) {
-+    GetPage()->SetVisibilityState(mojom::blink::PageVisibilityState::kVisible, is_initial_state);
-+    GetPage()->GetPageScheduler()->SetPageVisible(true);
-+    return;
-+  }
++  // If backgroundThrottling is disabled, the page (and everything observing
++  // its visibility, e.g. media) is told it is visible.
++  if (!scheduler_throttling_allowed_)
++    visibility_state = mojom::blink::PageVisibilityState::kVisible;
 +
    GetPage()->SetVisibilityState(visibility_state, is_initial_state);
    // Do not throttle if the page should be painting.
    bool is_visible =
 diff --git a/third_party/blink/renderer/core/exported/web_view_impl.h b/third_party/blink/renderer/core/exported/web_view_impl.h
-index 57ef111ae28017f4452baf6de46ac2480c58db24..f51c16423aa0129ed399edec1aa9c5ffcffa019b 100644
+index 57ef111ae28017f4452baf6de46ac2480c58db24..44aa8795d9aae67c1554742713f6dabf50739038 100644
 --- a/third_party/blink/renderer/core/exported/web_view_impl.h
 +++ b/third_party/blink/renderer/core/exported/web_view_impl.h
 @@ -445,6 +445,7 @@ class CORE_EXPORT WebViewImpl final : public WebView,
@@ -166,11 +180,15 @@ index 57ef111ae28017f4452baf6de46ac2480c58db24..f51c16423aa0129ed399edec1aa9c5ff
    void SetVisibilityState(mojom::blink::PageVisibilityState visibility_state,
                            bool is_initial_state) override;
    mojom::blink::PageVisibilityState GetVisibilityState() override;
-@@ -947,6 +948,8 @@ class CORE_EXPORT WebViewImpl final : public WebView,
+@@ -947,6 +948,12 @@ class CORE_EXPORT WebViewImpl final : public WebView,
    // If true, we send IPC messages when |preferred_size_| changes.
    bool send_preferred_size_changes_ = false;
  
 +  bool scheduler_throttling_allowed_ = true;
++  // The visibility most recently requested by the browser, before the
++  // |scheduler_throttling_allowed_| override is applied.
++  mojom::blink::PageVisibilityState browser_visibility_state_ =
++      mojom::blink::PageVisibilityState::kVisible;
 +
    // Whether the preferred size may have changed and |UpdatePreferredSize| needs
